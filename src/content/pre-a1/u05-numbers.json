        "steps": [
          {
            "id": "s01",
            "type": "orientation",
            "role": "orientation",
            "skill": "listening",
            "title_zh": "这节课学什么",
            "body_zh": "数字天天都在用：时间、公交、价格、楼层。这节课先打好 0–20 的基础，重点练一个很多人会混的地方：thirteen（13）和 thirty（30）。"
          },
          {
            "id": "s02",
            "type": "vocab",
            "role": "input",
            "skill": "vocabulary",
            "instructions_zh": "听一听，跟着数。注意 thirteen 和 thirty 重音的位置不同。",
            "items": [
              "zero",
              "one-to-ten",
              "eleven-twelve",
              "thirteen",
              "thirty",
              "fifteen-fifty"
            ]
          },
          {
            "id": "s03",
            "type": "dialogue",
            "role": "input",
            "skill": "listening",
            "title_en": "Which bus?",
            "instructions_zh": "先听。他要坐几路车？",
            "scene_zh": "Lin 在公交站问路人。",
            "lines": [
              {
                "speaker": "Lin",
                "en": "Excuse me, is this bus thirteen?",
                "zh": "打扰一下，这是 13 路吗？"
              },
              {
                "speaker": "Woman",
                "en": "No, this is bus thirty. Bus thirteen is over there.",
                "zh": "不，这是 30 路。13 路在那边。"
              },
              {
                "speaker": "Lin",
                "en": "Thirteen, over there. Thank you!",
                "zh": "13 路，在那边。谢谢！"
              }
            ]
          },
          {
            "id": "s04",
            "type": "notice",
            "role": "notice",
            "skill": "phonology",
            "question_zh": "大声读这三组数字，用力的音节在哪里？（粗体是重音）",
            "examples": [
              {
                "en": "thirTEEN — THIRty",
                "zh": "13 — 30",
                "highlight": [
                  "TEEN",
                  "THIR"
                ]
              },
              {
                "en": "fifTEEN — FIFty",
                "zh": "15 — 50",
                "highlight": [
                  "TEEN",
                  "FIF"
                ]
              },
              {
                "en": "eighTEEN — EIGHty",
                "zh": "18 — 80",
                "highlight": [
                  "TEEN",
                  "EIGH"
                ]
              }
            ],
            "takeaway_zh": "-teen（13–19）重音在后面，而且 -teen 的音拉得长；-ty（30、40……）重音在前面，结尾很短。听的时候抓住这个区别。"
          },
          {
            "id": "s05",
            "type": "choice",
            "role": "guided_practice",
            "skill": "listening",
            "prompt_zh": "听录音，选出你听到的数字。",
