    "grammar_points": [
      {
        "id": "pre-a1.numbers-questions",
        "title_en": "How old? How much?",
        "title_zh": "问年龄和价格",
        "pattern": "How old are you? — I'm 25.\nHow much is it? — It's 30 yuan.\nWhat's your phone number? — It's ...",
        "explanation_zh": "问年龄用 How old are you?，回答 I'm + 数字，可以加 years old，但不能只说 years。问价格用 How much is it?，回答 It's + 价格。电话号码一个一个数字地读，0 常读作 oh，两个相同的数字可以说 double。",
        "examples": [
          {
            "en": "I'm thirty-two.",
            "zh": "我三十二岁。"
          },
          {
            "en": "It's fifteen dollars.",
            "zh": "十五美元。"
          },
          {
            "en": "It's oh-one-three, double five ...",
            "zh": "号码是 013 55……"
          }
        ],
        "common_errors": [
          {
            "wrong": "I'm 30 years.",
            "right": "I'm 30. / I'm 30 years old.",
            "why_zh": "years 后面要加 old，或者干脆只说数字。"
          },
          {
            "wrong": "How many is it?",
            "right": "How much is it?",
            "why_zh": "问价格用 How much。How many 问的是“多少个”。"
          },
          {
            "wrong": "thirteen 和 thirty 读成一样",
            "right": "thir-TEEN / THIR-ty",
            "why_zh": "-teen 结尾的数字重音在后面，-ty 结尾的重音在前面。"
          }
        ]
      }
    ],
