    "can_do": [
      {
        "id": "pre-a1.si.introduce",
        "skill": "spoken_interaction",
        "en": "Can introduce themselves and ask others their name, where they are from and what they do.",
        "zh": "能介绍自己，并问对方的名字、来自哪里和做什么工作。"
      },
      {
        "id": "pre-a1.sp.personal-info",
        "skill": "spoken_production",
        "en": "Can give basic personal information in short, simple phrases.",
        "zh": "能用简短的句子说出自己的基本信息。"
      },
      {
        "id": "pre-a1.l.personal-info",
        "skill": "listening",
        "en": "Can understand names, countries and jobs when people introduce themselves slowly.",
        "zh": "别人慢慢做自我介绍时，能听懂名字、国家和职业。"
      }
    ],
    "grammar_points": [
      {
        "id": "pre-a1.introducing-yourself",
        "title_en": "Introducing yourself",
        "title_zh": "介绍自己",
        "pattern": "I'm / My name's + 名字\nI'm from + 地方\nI'm a / an + 职业",
        "explanation_zh": "介绍自己最常用 I'm（= I am）。说名字可以用 I'm Lin 或 My name's Lin；说来自哪里用 I'm from + 国家或城市；说职业时，职业名词前要加 a 或 an：以元音音素开头的词（engineer、office worker）用 an，其他用 a。",
        "examples": [
          {
            "en": "Hi, I'm Lin. I'm from Chengdu.",
            "zh": "你好，我是林。我来自成都。"
          },
          {
            "en": "I'm an engineer.",
            "zh": "我是一名工程师。"
          },
          {
            "en": "My name's David. I'm a teacher.",
            "zh": "我叫大卫，我是老师。"
          }
        ],
        "common_errors": [
          {
            "wrong": "I'm teacher.",
            "right": "I'm a teacher.",
            "why_zh": "说一个人的职业时，前面要加 a / an。"
          },
          {
            "wrong": "I am come from China.",
            "right": "I'm from China. / I come from China.",
            "why_zh": "am 和 come 不能同时用：用 I'm from，或者 I come from。"
          },
          {
            "wrong": "My name is call Lin.",
            "right": "My name is Lin.",
            "why_zh": "英语不需要“叫”这个词，name 后面直接跟名字。"
          }
        ]
      }
    ],
