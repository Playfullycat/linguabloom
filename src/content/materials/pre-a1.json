    {
      "id": "ls-pa1-new-classmate",
      "type": "listening",
      "level": "pre_a1",
      "topic": "greetings",
      "title_en": "A New Classmate",
      "title_zh": "新同学",
      "summary_zh": "两个人第一次见面，互相问名字和身体好不好。",
      "segments": [
        { "speaker": "Anna", "en": "Hi! I'm Anna.", "zh": "嗨！我是安娜。" },
        { "speaker": "Leo", "en": "Hello, Anna. I'm Leo.", "zh": "你好，安娜。我是利奥。" },
        { "speaker": "Anna", "en": "Nice to meet you, Leo.", "zh": "很高兴认识你，利奥。" },
        { "speaker": "Leo", "en": "Nice to meet you, too.", "zh": "我也很高兴认识你。" },
        { "speaker": "Anna", "en": "How are you today?", "zh": "你今天好吗？" },
        { "speaker": "Leo", "en": "I'm fine, thank you. And you?", "zh": "我很好，谢谢。你呢？" },
        { "speaker": "Anna", "en": "I'm good, thanks.", "zh": "我挺好的，谢谢。" },
        { "speaker": "Leo", "en": "Are you in Class Two?", "zh": "你在二班吗？" },
        { "speaker": "Anna", "en": "Yes, I am. See you in class!", "zh": "是的。课上见！" }
      ],
      "glossary": [
        { "key": "nice-to-meet-you", "text": "Nice to meet you", "pos": "phrase", "ipa": "/naɪs tə miːt juː/", "zh": "很高兴认识你" },
        { "key": "today", "text": "today", "pos": "adverb", "ipa": "/təˈdeɪ/", "zh": "今天" },
        { "key": "fine", "text": "fine", "pos": "adjective", "ipa": "/faɪn/", "zh": "很好的；健康的" },
        { "key": "and-you", "text": "And you", "pos": "phrase", "ipa": "/ənd juː/", "zh": "你呢？" },
        { "key": "thanks", "text": "thanks", "pos": "exclamation", "ipa": "/θæŋks/", "zh": "谢谢（口语）" },
        { "key": "class", "text": "class", "pos": "noun", "ipa": "/klɑːs/", "zh": "班级；课" },
        { "key": "see-you", "text": "See you", "pos": "phrase", "ipa": "/siː juː/", "zh": "回头见" }
      ],
      "questions": [
        { "id": "q1", "type": "choice", "prompt_zh": "男生叫什么名字？", "options": ["Leo", "Ben", "Tom"], "answer": 0, "explanation_zh": "原文：Hello, Anna. I'm Leo.", "segment": 1 },
        { "id": "q2", "type": "choice", "prompt_zh": "Leo 今天怎么样？", "options": ["很累", "很好", "生病了"], "answer": 1, "explanation_zh": "原文：I'm fine, thank you.", "segment": 5 },
        { "id": "q3", "type": "choice", "prompt_zh": "安娜在几班？", "options": ["一班", "二班", "三班"], "answer": 1, "explanation_zh": "Leo 问 Are you in Class Two? 安娜回答 Yes, I am.", "segment": 8 }
      ]
    },
    {
      "id": "ls-pa1-phone-number",
      "type": "listening",
      "level": "pre_a1",
      "topic": "numbers",
      "title_en": "What's Your Phone Number?",
      "title_zh": "你的电话号码是多少？",
      "summary_zh": "两个朋友交换电话号码，听清每一个数字。",
      "segments": [
        { "speaker": "Sam", "en": "What's your phone number, Lily?", "zh": "莉莉，你的电话号码是多少？" },
        { "speaker": "Lily", "en": "It's six, two, four, nine, eight.", "zh": "是 6、2、4、9、8。" },
        { "speaker": "Sam", "en": "Six, two, four, nine, eight?", "zh": "6、2、4、9、8？" },
        { "speaker": "Lily", "en": "Yes, that's right.", "zh": "对，没错。" },
        { "speaker": "Lily", "en": "And what's your number?", "zh": "那你的号码是多少？" },
        { "speaker": "Sam", "en": "It's three, seven, one, five, zero.", "zh": "是 3、7、1、5、0。" },
        { "speaker": "Lily", "en": "Sorry, can you say it again?", "zh": "不好意思，你能再说一遍吗？" },
        { "speaker": "Sam", "en": "Three, seven, one, five, zero.", "zh": "3、7、1、5、0。" },
        { "speaker": "Lily", "en": "Thank you. Bye!", "zh": "谢谢。再见！" }
      ],
      "glossary": [
        { "key": "phone-number", "text": "phone number", "pos": "noun", "ipa": "/fəʊn ˈnʌmbə/", "zh": "电话号码" },
        { "key": "number", "text": "number", "pos": "noun", "ipa": "/ˈnʌmbə/", "zh": "号码；数字" },
        { "key": "thats-right", "text": "that's right", "pos": "phrase", "ipa": "/ðæts raɪt/", "zh": "没错；对" },
        { "key": "zero", "text": "zero", "pos": "number", "ipa": "/ˈzɪərəʊ/", "zh": "零" },
        { "key": "sorry", "text": "Sorry", "pos": "exclamation", "ipa": "/ˈsɒri/", "zh": "不好意思；对不起" },
        { "key": "say-it-again", "text": "say it again", "pos": "phrase", "ipa": "/seɪ ɪt əˈɡen/", "zh": "再说一遍" },
        { "key": "bye", "text": "Bye", "pos": "exclamation", "ipa": "/baɪ/", "zh": "再见" }
      ],
      "questions": [
        { "id": "q1", "type": "choice", "prompt_zh": "莉莉的号码是哪一个？", "options": ["62498", "62489", "26498"], "answer": 0, "explanation_zh": "原文：six, two, four, nine, eight。", "segment": 1 },
        { "id": "q2", "type": "choice", "prompt_zh": "萨姆的号码最后一个数字是什么？", "options": ["五", "零", "一"], "answer": 1, "explanation_zh": "原文：three, seven, one, five, zero —— zero 是零。", "segment": 5 },
        { "id": "q3", "type": "choice", "prompt_zh": "莉莉为什么说 Sorry？", "options": ["她打错电话了", "她想让萨姆再说一遍", "她要走了"], "answer": 1, "explanation_zh": "原文：Sorry, can you say it again? 请对方重复。", "segment": 6 }
      ]
    }
  ]
