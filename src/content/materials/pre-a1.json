      "segments": [
        { "en": "Today we are at the zoo.", "zh": "今天我们在动物园。" },
        { "en": "I can see two big elephants.", "zh": "我能看到两头大象。" },
        { "en": "They are grey and very tall.", "zh": "它们是灰色的，非常高。" },
        { "en": "The monkeys are funny.", "zh": "猴子们很好笑。" },
        { "en": "They jump and play in the trees.", "zh": "它们在树上跳来跳去地玩。" },
        { "en": "My little brother likes the lions.", "zh": "我弟弟喜欢狮子。" },
        { "en": "I like the penguins best.", "zh": "我最喜欢企鹅。" },
        { "en": "They are black and white.", "zh": "它们是黑白色的。" }
      ],
      "glossary": [
        { "key": "zoo", "text": "zoo", "pos": "noun", "ipa": "/zuː/", "zh": "动物园" },
        { "key": "elephant", "text": "elephant", "forms": ["elephants"], "pos": "noun", "ipa": "/ˈelɪfənt/", "zh": "大象" },
