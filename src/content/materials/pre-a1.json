      "title_en": "This Is Mia",
      "title_zh": "这是米娅",
      "summary_zh": "米娅介绍自己和她的朋友：名字、年龄和来自哪里。",
      "segments": [
        { "en": "Hello! My name is Mia.", "zh": "你好！我叫米娅。" },
        { "en": "I am ten years old.", "zh": "我十岁。" },
        { "en": "I am from China.", "zh": "我来自中国。" },
        { "en": "This is my friend Ben.", "zh": "这是我的朋友本。" },
        { "en": "He is eleven.", "zh": "他十一岁。" },
        { "en": "He is from Canada.", "zh": "他来自加拿大。" },
        { "en": "We are in the same class.", "zh": "我们在同一个班。" },
        { "en": "Our teacher is Ms Green.", "zh": "我们的老师是格林女士。" },
        { "en": "She is very nice.", "zh": "她人很好。" }
      ],
      "glossary": [
        { "key": "name", "text": "name", "pos": "noun", "ipa": "/neɪm/", "zh": "名字" },
        { "key": "years-old", "text": "years old", "pos": "phrase", "ipa": "/jɪəz əʊld/", "zh": "……岁", "note_zh": "ten years old = 十岁" },
        { "key": "from", "text": "from", "pos": "preposition", "ipa": "/frɒm/", "zh": "来自；从" },
        { "key": "friend", "text": "friend", "pos": "noun", "ipa": "/frend/", "zh": "朋友" },
        { "key": "eleven", "text": "eleven", "pos": "number", "ipa": "/ɪˈlevn/", "zh": "十一" },
        { "key": "same", "text": "same", "pos": "adjective", "ipa": "/seɪm/", "zh": "相同的" },
        { "key": "class", "text": "class", "pos": "noun", "ipa": "/klɑːs/", "zh": "班级" },
        { "key": "teacher", "text": "teacher", "pos": "noun", "ipa": "/ˈtiːtʃə/", "zh": "老师" },
        { "key": "nice", "text": "nice", "pos": "adjective", "ipa": "/naɪs/", "zh": "友好的；好的" }
      ],
      "questions": [
        { "id": "q1", "type": "choice", "prompt_zh": "米娅几岁？", "options": ["十岁", "十一岁", "十二岁"], "answer": 0, "explanation_zh": "原文：I am ten years old.", "segment": 1 },
        { "id": "q2", "type": "choice", "prompt_zh": "本来自哪里？", "options": ["中国", "加拿大", "英国"], "answer": 1, "explanation_zh": "原文：He is from Canada.", "segment": 5 },
        { "id": "q3", "type": "choice", "prompt_zh": "Ms Green 是谁？", "options": ["米娅的妈妈", "本的姐姐", "他们的老师"], "answer": 2, "explanation_zh": "原文：Our teacher is Ms Green.", "segment": 7 }
      ]
    },
    {
      "id": "rd-pa1-my-bag",
      "type": "reading",
      "level": "pre_a1",
      "topic": "things",
      "title_en": "What Is in My Bag?",
      "title_zh": "我的包里有什么？",
      "summary_zh": "一个学生说说书包里的东西：数量和颜色。",
      "segments": [
        { "en": "This is my bag.", "zh": "这是我的包。" },
        { "en": "It is blue.", "zh": "它是蓝色的。" },
        { "en": "In my bag, I have two books.", "zh": "我的包里有两本书。" },
        { "en": "I have three pens.", "zh": "我有三支笔。" },
        { "en": "One pen is red, and two pens are black.", "zh": "一支笔是红色的，两支是黑色的。" },
        { "en": "I have an apple and a bottle of water.", "zh": "我有一个苹果和一瓶水。" },
        { "en": "My phone is in my bag, too.", "zh": "我的手机也在包里。" },
        { "en": "Where are my keys?", "zh": "我的钥匙在哪儿？" },
        { "en": "Oh, they are on the table!", "zh": "哦，在桌子上！" }
      ],
      "glossary": [
