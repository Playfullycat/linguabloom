      ],
      "questions": [
        { "id": "q1", "type": "choice", "prompt_zh": "包是什么颜色的？", "options": ["红色", "蓝色", "黑色"], "answer": 1, "explanation_zh": "原文：It is blue.", "segment": 1 },
        { "id": "q2", "type": "choice", "prompt_zh": "包里有几支笔？", "options": ["两支", "三支", "四支"], "answer": 1, "explanation_zh": "原文：I have three pens.", "segment": 3 },
        { "id": "q3", "type": "choice", "prompt_zh": "钥匙在哪里？", "options": ["包里", "桌子上", "手机旁边"], "answer": 1, "explanation_zh": "原文：Oh, they are on the table!", "segment": 8 }
