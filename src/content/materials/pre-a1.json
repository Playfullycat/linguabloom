      "level": "pre_a1",
      "can_do_ids": ["pre-a1.r.words-signs"],
      "topic": "celebrations",
      "title_en": "Happy Birthday, Leo!",
      "title_zh": "生日快乐，利奥！",
      "summary_zh": "奶奶写给七岁孙子的生日卡片：礼物是什么，周六一起做什么。",
      "segments": [
        { "en": "Dear Leo,", "zh": "亲爱的利奥：" },
        { "en": "Happy birthday! You are seven today.", "zh": "生日快乐！你今天七岁了。" },
        { "en": "This is a present from me.", "zh": "这是我送你的礼物。" },
        { "en": "It is a red ball.", "zh": "是一个红色的球。" },
        { "en": "Let's play football in the park on Saturday.", "zh": "我们周六去公园踢足球吧。" },
        { "en": "Have a great day with your friends.", "zh": "和朋友们玩得开心！" },
        { "en": "See you soon!", "zh": "回头见！" },
        { "en": "Love, Grandma", "zh": "爱你的奶奶" }
      ],
      "glossary": [
