        { "key": "lets", "text": "Let's", "pos": "phrase", "zh": "我们……吧", "note_zh": "Let's play = 我们一起玩吧" },
        { "key": "football", "text": "football", "pos": "noun", "ipa": "/ˈfʊtbɔːl/", "zh": "足球" },
        { "key": "see-you-soon", "text": "See you soon", "pos": "phrase", "zh": "回头见；很快再见" }
      ],
      "questions": [
        { "id": "q1", "type": "choice", "prompt_zh": "利奥今天几岁？", "options": ["七岁", "六岁", "八岁"], "answer": 0, "explanation_zh": "原文：You are seven today.", "segment": 1 },
        { "id": "q2", "type": "choice", "prompt_zh": "礼物是什么？", "options": ["一个红色的球", "一本书", "一只小猫"], "answer": 0, "explanation_zh": "原文：It is a red ball.", "segment": 3 },
        { "id": "q3", "type": "choice", "prompt_zh": "奶奶想周六做什么？", "options": ["去奶奶家吃饭", "去商店买球", "在公园踢足球"], "answer": 2, "explanation_zh": "原文：Let's play football in the park on Saturday.", "segment": 4 }
      ]
