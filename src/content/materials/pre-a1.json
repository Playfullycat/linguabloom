        { "key": "book", "text": "book", "forms": ["books"], "pos": "noun", "ipa": "/bʊk/", "zh": "书" },
        { "key": "pen", "text": "pen", "forms": ["pens"], "pos": "noun", "ipa": "/pen/", "zh": "笔" },
        { "key": "red", "text": "red", "pos": "adjective", "ipa": "/red/", "zh": "红色的" },
        { "key": "black", "text": "black", "pos": "adjective", "ipa": "/blæk/", "zh": "黑色的" },
        { "key": "bottle-of-water", "text": "a bottle of water", "pos": "phrase", "ipa": "/ə ˈbɒtl əv ˈwɔːtə/", "zh": "一瓶水" },
        { "key": "phone", "text": "phone", "pos": "noun", "ipa": "/fəʊn/", "zh": "手机；电话" },
        { "key": "too", "text": "too", "pos": "adverb", "ipa": "/tuː/", "zh": "也", "note_zh": "放在句末：My phone is in my bag, too." },
