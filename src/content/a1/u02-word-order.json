        "steps": [
          {
            "id": "s01",
            "type": "orientation",
            "role": "orientation",
            "skill": "grammar",
            "title_zh": "这节课学什么",
            "body_zh": "英语句子有一个固定的骨架：谁 + 做什么 + 什么。这个顺序和中文差不多，但英语几乎从不省略主语。这节课用“喜欢、吃、喝”练熟这个骨架。"
          },
          {
            "id": "s02",
            "type": "dialogue",
            "role": "input",
            "skill": "listening",
            "title_en": "Lunch break",
            "instructions_zh": "先听。他们喜欢喝什么？",
            "scene_zh": "午休时，Lin 和同事 Sara 在公司楼下的咖啡店。",
            "lines": [
              {
                "speaker": "Sara",
                "en": "I drink coffee every day. What about you?",
                "zh": "我每天都喝咖啡。你呢？"
              },
              {
                "speaker": "Lin",
                "en": "I don't like coffee. I like tea.",
                "zh": "我不喜欢咖啡，我喜欢茶。"
              },
              {
                "speaker": "Sara",
                "en": "Really? I like tea too, but I love coffee!",
                "zh": "真的吗？我也喜欢茶，不过我更爱咖啡！"
              }
            ]
          },
          {
            "id": "s03",
            "type": "vocab",
            "role": "input",
            "skill": "vocabulary",
            "instructions_zh": "听一听，跟读这些常用动词。",
            "items": [
              "drink",
              "eat",
              "like",
              "play",
              "watch"
            ]
          },
          {
            "id": "s04",
            "type": "notice",
            "role": "notice",
            "skill": "grammar",
            "question_zh": "看下面三句话，主语、动词、宾语分别在哪里？",
            "examples": [
              {
                "en": "I like tea.",
                "zh": "我喜欢茶。",
                "highlight": [
                  "like"
                ]
              },
              {
                "en": "We eat rice.",
                "zh": "我们吃米饭。",
                "highlight": [
                  "eat"
                ]
              },
              {
                "en": "They watch football.",
                "zh": "他们看足球。",
                "highlight": [
                  "watch"
                ]
              }
            ],
            "takeaway_zh": "主语在最前面，动词紧跟着（标黄的词），宾语在动词后面。英语句子一般都要有主语。"
          },
