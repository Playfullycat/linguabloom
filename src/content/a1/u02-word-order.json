              {
                "speaker": "Lin",
                "en": "I live in Pudong. I take the metro to work.",
                "zh": "我住在浦东，坐地铁上班。"
              },
              {
                "speaker": "Ken",
                "en": "When do you start work?",
                "zh": "你几点开始上班？"
              },
              {
                "speaker": "Lin",
                "en": "I start work at nine. I have lunch in the canteen at twelve.",
                "zh": "我九点上班，十二点在食堂吃午饭。"
              }
            ]
          },
          {
            "id": "s03",
            "type": "vocab",
            "role": "input",
            "skill": "vocabulary",
            "instructions_zh": "听一听，跟读。",
