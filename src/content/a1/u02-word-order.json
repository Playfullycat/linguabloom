        ],
        "steps": [
          {
            "id": "s01",
            "type": "orientation",
            "role": "orientation",
            "skill": "grammar",
            "title_zh": "这节课学什么",
            "body_zh": "中文常说“我每天早上在家喝咖啡”，时间和地点放在动词前面。英语通常把它们放在句末：I drink coffee at home every morning。这节课专门练这个“搬家”。"
          },
          {
            "id": "s02",
            "type": "dialogue",
            "role": "input",
            "skill": "listening",
            "title_en": "A new colleague",
