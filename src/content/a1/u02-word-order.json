    "grammar_points": [
      {
        "id": "a1.basic-word-order",
        "title_en": "Basic word order",
        "title_zh": "基本词序",
        "pattern": "主语 + 动词 + 宾语 + 地点 + 时间\nI drink coffee at work every morning.\n形容词 + 名词：a small flat",
        "explanation_zh": "英语句子的顺序比中文固定：先说谁（主语），再说做什么（动词），然后是对象（宾语）。地点和时间一般放在句末，地点在前、时间在后。中文常把时间放在前面（“我每天早上喝咖啡”），英语通常放在最后。形容词放在名词前面：a red car，不说 a car red。",
        "examples": [
          {
            "en": "We watch films at home on Fridays.",
            "zh": "我们周五在家看电影。"
          },
          {
            "en": "I live in a small flat.",
            "zh": "我住在一套小公寓里。"
          },
          {
            "en": "They play football in the park on Sundays.",
            "zh": "他们周日在公园踢足球。"
          }
        ],
        "common_errors": [
          {
            "wrong": "I every morning drink coffee.",
            "right": "I drink coffee every morning.",
            "why_zh": "时间短语一般放在句末，不插在主语和动词之间。"
          },
          {
            "wrong": "I like very much tea.",
            "right": "I like tea very much.",
            "why_zh": "very much 放在宾语后面。"
          },
          {
            "wrong": "a car red",
            "right": "a red car",
            "why_zh": "形容词放在名词前面。"
          }
        ]
      }
    ],
