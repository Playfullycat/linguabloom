        "title_en": "I Am, You Are, We Are",
        "title_zh": "我是，你是，我们是",
        "estimated_minutes": 9,
        "objectives": [
          {
            "en": "Use I'm, you're, we're and they're.",
            "zh": "能用 I'm、you're、we're、they're。"
          },
          {
            "en": "Remember that adjectives need be: I'm busy.",
            "zh": "记住形容词前要有 be：I'm busy。"
          }
        ],
        "can_do_ids": [
          "a1.gr.be",
          "a1.sp.describe-people"
        ],
        "steps": [
          {
            "id": "s01",
            "type": "orientation",
            "role": "orientation",
            "skill": "grammar",
            "title_zh": "这节课学什么",
            "body_zh": "中文说“我很忙”，英语要说 I'm busy：中间这个 'm（am）不能省。这节课从 I、you、we、they 开始，把 be 动词用顺。"
          },
          {
            "id": "s02",
            "type": "dialogue",
            "role": "input",
            "skill": "listening",
            "title_en": "Monday morning",
            "instructions_zh": "先听，注意每句话里的 'm 和 're。",
            "scene_zh": "周一早上，两个同事在电梯里。",
            "lines": [
              {
                "speaker": "Tom",
                "en": "Morning, Lin. Are you OK?",
                "zh": "早，林。你还好吗？"
              },
              {
                "speaker": "Lin",
                "en": "I'm fine, just tired. We're very busy this week.",
                "zh": "我还好，就是有点累。我们这周特别忙。"
              },
              {
                "speaker": "Tom",
                "en": "Yeah, you're right. The new clients are here today.",
                "zh": "是啊，你说得对。新客户今天来。"
              },
              {
                "speaker": "Lin",
                "en": "They're in the meeting room now.",
                "zh": "他们现在就在会议室。"
              }
            ]
          },
          {
            "id": "s03",
            "type": "vocab",
            "role": "input",
            "skill": "vocabulary",
            "instructions_zh": "听一听，跟读。",
            "items": [
              "i",
              "you",
              "we",
              "they",
              "tired",
              "busy",
              "happy",
              "at-home"
