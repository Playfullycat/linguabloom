          },
          {
            "id": "s04",
            "type": "notice",
            "role": "notice",
            "skill": "grammar",
            "question_zh": "看看 be 动词跟着谁变：",
            "examples": [
              {
                "en": "I'm busy.",
                "zh": "我很忙。",
                "highlight": [
                  "I'm"
