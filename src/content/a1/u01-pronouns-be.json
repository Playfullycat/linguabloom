        "skill": "spoken_production",
        "en": "Can describe themselves and other people with simple sentences using be.",
        "zh": "能用 be 的简单句描述自己和别人。"
      },
      {
        "id": "a1.gr.be",
        "skill": "grammar",
        "en": "Can use am, is and are (and their negatives) correctly with subject pronouns.",
        "zh": "能把 am / is / are 及其否定形式和人称代词正确搭配。"
      },
      {
        "id": "a1.l.people",
        "skill": "listening",
        "en": "Can follow short, slow descriptions of people.",
        "zh": "能听懂语速慢的简短人物描述。"
      }
    ],
    "grammar_points": [
      {
        "id": "a1.subject-pronouns-be",
        "title_en": "Subject pronouns + be",
        "title_zh": "主语代词 + be 动词",
        "pattern": "I am (I'm)\nyou / we / they are (you're, we're, they're)\nhe / she / it is (he's, she's, it's)\n否定：I'm not / isn't / aren't",
        "explanation_zh": "be 动词（am / is / are）把主语和后面的信息连起来：身份、国籍、年龄、状态、地点。I 用 am；he / she / it 和单个人或物用 is；you / we / they 和多个人或物用 are。口语里几乎都用缩写。否定在 be 后面加 not。",
        "examples": [
          {
            "en": "I'm tired.",
            "zh": "我累了。"
          },
          {
            "en": "She's a nurse. She isn't a doctor.",
            "zh": "她是护士，不是医生。"
          },
          {
            "en": "We're from Chengdu.",
            "zh": "我们是成都人。"
          }
        ],
        "common_errors": [
          {
            "wrong": "She are my sister.",
            "right": "She's my sister.",
            "why_zh": "she 后面用 is。"
          },
          {
            "wrong": "I very busy.",
            "right": "I'm very busy.",
            "why_zh": "形容词前面不能少了 be 动词。中文说“我很忙”，英语要说 I am busy。"
          },
          {
            "wrong": "He not is here.",
            "right": "He isn't here. / He's not here.",
            "why_zh": "not 放在 be 后面。"
          }
        ]
      }
    ],
