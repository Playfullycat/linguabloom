        "steps": [
          {
            "id": "s01",
            "type": "orientation",
            "role": "orientation",
            "skill": "grammar",
            "title_zh": "这节课学什么",
            "body_zh": "句子里没有 be、而是普通动词（like、live、work）时，不能把动词挪到前面，要在句首加 Do：You like tea → Do you like tea?。这是中文母语者最容易漏掉的一步。"
          },
          {
            "id": "s02",
            "type": "dialogue",
            "role": "input",
            "skill": "listening",
            "title_en": "Getting to know you",
            "instructions_zh": "先听。Kate 喜欢什么？会不会开车？",
            "scene_zh": "课间休息，Lin 和 Kate 聊天。",
            "lines": [
              {
                "speaker": "Lin",
                "en": "Do you like coffee?",
                "zh": "你喜欢咖啡吗？"
              },
              {
                "speaker": "Kate",
                "en": "Yes, I do. I love it. Do you?",
                "zh": "喜欢，我很爱喝。你呢？"
              },
              {
                "speaker": "Lin",
                "en": "No, I don't. I like tea. Do you drive to class?",
                "zh": "我不喜欢，我喜欢茶。你开车来上课吗？"
              },
              {
                "speaker": "Kate",
                "en": "No, I don't. I take the bus.",
                "zh": "不，我坐公交。"
              }
            ]
          },
          {
            "id": "s03",
            "type": "vocab",
            "role": "input",
            "skill": "vocabulary",
            "instructions_zh": "听一听，跟读。",
            "items": [
              "do-you",
              "yes-i-do",
              "no-i-dont"
            ]
          },
          {
            "id": "s04",
            "type": "teach",
            "role": "teach",
            "skill": "grammar",
            "title_zh": "什么时候用 Do？",
            "explanation_zh": "先看句子里有没有 am / is / are：有，就把它提前（Are you busy?）；没有，句子里是普通动词，就在句首加 Do，动词保持原样（Do you like tea?）。回答也对应：Are you ...? 用 I am / I'm not；Do you ...? 用 I do / I don't。",
            "pattern": "Do + you / we / they + 动词 ...?",
            "examples": [
              {
                "en": "Do you live near here?",
                "zh": "你住在附近吗？"
              },
              {
                "en": "Do they work on Saturdays? — No, they don't.",
                "zh": "他们周六上班吗？——不上。"
              }
            ],
            "tips_zh": [
              "不要说 Do you are ...?，be 和 do 不一起用。",
              "Yes, I like 不对，要说 Yes, I do。"
            ]
          },
          {
            "id": "s05",
            "type": "choice",
            "role": "guided_practice",
            "skill": "grammar",
            "prompt_zh": "选出正确的问句：",
            "options": [
              "Like you music?",
              "Do you like music?",
              "Are you like music?"
            ],
            "answer": 1,
            "explanation_zh": "like 是普通动词，句首加 Do：Do you like music?"
          },
          {
            "id": "s06",
            "type": "match",
            "role": "guided_practice",
            "skill": "grammar",
            "instructions_zh": "把问句和合适的简略回答配对。",
            "pairs": [
