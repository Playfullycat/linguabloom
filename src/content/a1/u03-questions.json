    "summary_zh": "用 be 和 do 提问、用简短的 Yes / No 回答，以及 what / where / who 开头的问题。学完后，你能和新认识的人进行一段简单的一问一答。",
    "can_do": [
      {
        "id": "a1.si.ask-answer",
        "skill": "spoken_interaction",
        "en": "Can ask and answer simple questions about familiar topics.",
        "zh": "能就熟悉的话题进行简单的问答。"
      },
      {
        "id": "a1.gr.questions",
        "skill": "grammar",
        "en": "Can form yes/no questions with be and do, short answers, and simple wh-questions.",
        "zh": "能用 be 和 do 构成一般疑问句、简略回答和简单的特殊疑问句。"
      },
      {
        "id": "a1.l.questions",
        "skill": "listening",
        "en": "Can recognise simple questions and answer them when spoken slowly.",
        "zh": "对方慢慢说时，能听懂简单的问题并作答。"
      }
    ],
    "grammar_points": [
      {
        "id": "a1.questions-be-do",
        "title_en": "Questions with be and do",
        "title_zh": "be 和 do 的问句",
        "pattern": "Are you a student? — Yes, I am. / No, I'm not.\nDo you like tea? — Yes, I do. / No, I don't.\nWhere do you live? / What's your job?",
        "explanation_zh": "句子里有 be（am / is / are）时，把 be 移到主语前面就成了问句。句子里是普通动词（like、live、work）时，在句首加 Do，动词不变。简略回答只重复 be 或 do，不重复整句。what / where / who 开头的问题，把疑问词放在最前面，后面是问句的语序。",
        "examples": [
          {
            "en": "Is she your sister? — Yes, she is.",
            "zh": "她是你姐姐吗？——是的。"
          },
          {
            "en": "Do you work here? — No, I don't.",
            "zh": "你在这儿工作吗？——不是。"
          },
          {
            "en": "Where do you work?",
            "zh": "你在哪儿工作？"
          }
        ],
        "common_errors": [
          {
            "wrong": "You are a student?",
            "right": "Are you a student?",
            "why_zh": "be 要放到主语前面（口语里升调说陈述句有时也行，但标准问句是倒装）。"
          },
          {
            "wrong": "Do you are busy?",
            "right": "Are you busy?",
            "why_zh": "有 be 的句子直接倒装，不加 do。"
          },
          {
            "wrong": "Yes, I like.",
            "right": "Yes, I do.",
            "why_zh": "简略回答用 do，不重复动词。"
          }
        ]
      }
    ],
