# Normalise line endings to LF in the repository and in working copies.
# Shell scripts and Docker files run inside Linux containers, where CRLF breaks them.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
