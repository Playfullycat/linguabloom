{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "linguabloom-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "linguabloom-dev-mock-ai",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3010"
      ],
      "port": 3010,
      "env": {
        "AI_ENABLED": "true",
        "AI_PROVIDER": "mock"
      }
    }
  ]
}
