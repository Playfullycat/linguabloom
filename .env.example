# LinguaBloom environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# (required) = must be set; (optional) = has a safe default or can stay empty.

# ---- App -------------------------------------------------------------------
# (required) The URL you open in the browser. Use https:// once deployed behind
# TLS; cookies then become Secure automatically.
APP_URL=http://localhost:3000
# (optional, docker) Host port for the app. May include a bind address, e.g.
# 127.0.0.1:3000 when a reverse proxy on the same machine serves HTTPS.
APP_PORT=3000
# (required) Long random secret (≥ 32 chars) used to sign sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-with-long-random-secret

# ---- Database --------------------------------------------------------------
# (required) Used by docker compose to create the database.
# Use a URL-safe password (letters, digits, - and _), e.g.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_USER=lingua
POSTGRES_PASSWORD=change-me
POSTGRES_DB=linguabloom
# (optional) Host port for local access. Bound to 127.0.0.1 only.
DB_PORT=5432
# (required for npm run dev / tests) Connection string when the app runs on
# your machine. Docker compose builds its own (host `db`) from POSTGRES_*.
DATABASE_URL=postgresql://lingua:change-me@localhost:5432/linguabloom
# (optional) Database for integration / E2E tests. Defaults to DATABASE_URL
# with "_test" appended to the database name. It is wiped on every test run.
# TEST_DATABASE_URL=postgresql://lingua:change-me@localhost:5432/linguabloom_test

# ---- First-run setup -------------------------------------------------------
# (optional) Allow creating the owner account at /setup. Setup closes itself
# once the owner exists; set to false to keep it closed on a fresh install.
OWNER_SETUP_ENABLED=true
# (optional) If set, /setup also asks for this token. Recommended when the
# server is reachable from the internet before you finish setup.
OWNER_SETUP_TOKEN=

# ---- Storage & locale ------------------------------------------------------
# (optional, npm run dev) Where uploads, audio and cache files are stored.
# In docker this is always /app/data (the `appdata` volume).
STORAGE_ROOT=./data
# (optional)
DEFAULT_LOCALE=zh-CN
DEFAULT_TIMEZONE=Asia/Shanghai
# (optional) debug | info | warn | error
LOG_LEVEL=info

# ---- AI (Phase 3, optional) ------------------------------------------------
# Non-AI features work with AI disabled. Keys are read on the server only.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_REALTIME_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_TTS_MODEL=
